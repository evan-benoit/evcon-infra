{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [ 

        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Python: PopulateTodaysLeagues",
            "type": "debugpy",
            "request": "launch",
            "program": "src/populateLeagueSeason/main.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": ["--populateTodaysLeagues"],
            "python": "${workspaceFolder}/src/populateLeagueSeason/.venv/bin/python",
            "cwd": "${workspaceFolder}"

        },
        {
            "name": "Python: Populate the past 7 days' leagues",
            "type": "debugpy",
            "request": "launch",
            "program": "src/populateLeagueSeason/main.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": ["--populateTodaysLeagues", "--backdate", "7"],
            "python": "${workspaceFolder}/src/populateLeagueSeason/.venv/bin/python",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Python: Populate the premier league (no AI)",
            "type": "debugpy",
            "request": "launch",
            "program": "src/populateLeagueSeason/main.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": ["--premier", "--skipgenai"],
            "python": "${workspaceFolder}/src/populateLeagueSeason/.venv/bin/python",
            "cwd": "${workspaceFolder}"

        },
        {
            "name": "Python: GetBetterHalf",
            "type": "debugpy",
            "request": "launch",
            "program": "src/betterHalf/main.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": ["uk", "39", "2023-09-24", "2023-09-24", "Europe/London", "--cacheBuster"],
            "python": "${workspaceFolder}/src/betterHalf/.venv/bin/python",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Scratch",
            "type": "debugpy",
            "request": "launch",
            "program": "src/scratch/main.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": [],
            "python": "${workspaceFolder}/src/scratch/.venv/bin/python",
            "cwd": "${workspaceFolder}"
        }
    ]
}